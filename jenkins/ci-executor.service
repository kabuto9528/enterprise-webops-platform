[Unit]
Description=WebOps CI release executor (fixed root command, no arguments)
Documentation=file:///home/ops/webops/docs/runbooks/cicd.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/webops-ci-release
User=root
Group=root
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
TimeoutStartSec=5400
StandardOutput=journal
StandardError=journal
