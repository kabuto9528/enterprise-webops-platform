global:
  scrape_interval: 30s
  scrape_timeout: 10s
  evaluation_interval: 30s
{% if stage09_alerting_enabled | default(false) %}
rule_files:
  - /etc/webops-monitoring/prometheus/alerts.yml
alerting:
  alertmanagers:
    - static_configs:
        - targets: ['127.0.0.1:9093']
{% endif %}
scrape_configs:
  - job_name: node
    static_configs:
      - targets: ['127.0.0.1:9100']
        labels: {node: monitor01, instance: monitor01}
      - targets: ['{{ ops_metrics_target }}']
        labels: {node: ops01, instance: ops01}
      - targets: ['127.0.0.1:19100']
        labels: {node: web01-hz, instance: web01-hz}
  - job_name: prometheus
    static_configs:
      - targets: ['127.0.0.1:9090']
        labels: {instance: monitor01}
  - job_name: blackbox
    static_configs:
      - targets: ['127.0.0.1:9115']
        labels: {instance: monitor01}
  - job_name: http_health
    metrics_path: /probe
    params:
      module: [http_health]
    static_configs:
      - targets: ['{{ cloud_health_url }}']
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - target_label: instance
        replacement: web01-hz-http
      - target_label: __address__
        replacement: '127.0.0.1:9115'
